+	cheats_settings_apply(FALSE);
 	if (cheat.controller_enabled)
 	{
 		short local_player_index;
@@ -310,6 +580,7 @@
 	void)
 {
 	cheats_load();
+	cheats_settings_apply(TRUE);
 
 	return;
 }

+/* ---------- port: the guide arrow's objective (TRUCOS, GUIA, OBJETIVO DE LA
+MISION). A campaign level moves on as the player walks into trigger volumes: its
+scripts wait for them (sleep_until with volume_test_objects ... (players)). The
+level's progression scripts, in the order it wakes them, are listed in
+hs_port_guide_routes.h; the arrow points at the volume the first of them that is
+waiting is waiting for, read from its running thread, so it follows the level and
+a saved game. Scripts behind the furthest place the player has been are skipped,
+in case the player went around one of their volumes */
+
+#include "hs/hs_port_guide_routes.h"
+
+#define HS_PORT_GUIDE_MAXIMUM_SCRIPTS 192
+#define HS_PORT_GUIDE_MAXIMUM_VOLUMES 512
+#define HS_PORT_GUIDE_MAXIMUM_NODES 4096
+#define HS_PORT_GUIDE_MAXIMUM_DEPTH 3
+
+static struct
+{
+	void const *scripts_address; /* the scenario's scripts the route was matched for */
+	long scripts_count;
+	boolean matched;
+	short count;
+	short script_indices[HS_PORT_GUIDE_MAXIMUM_SCRIPTS];
+	short volume_order[HS_PORT_GUIDE_MAXIMUM_VOLUMES]; /* NONE: not the route's */
+	short progress;
+	long last_time;
+	short functions_read;
+	short volume_functions[4];
+	short player_functions[2];
+} hs_port_guide;
+
+/* a syntax node, or NULL: every index is checked, as a script may be broken */
+static struct hs_syntax_node *hs_port_guide_node(
+	long index)
+{
+	struct hs_syntax_node *node = NULL;
+
+	if (index!=NONE && hs_syntax_data && hs_syntax_data->valid)
+	{
+		short absolute_index = (short)(index&0xFFFF);
+		short identifier = (short)(index>>16);
+
+		if (absolute_index>=0 && absolute_index<hs_syntax_data->maximum_count)
+		{
+			node = (struct hs_syntax_node *)((byte *)hs_syntax_data->data+hs_syntax_data->size*absolute_index);
+			if (!node->datum_header || (identifier && node->datum_header!=identifier))
+				node = NULL;
+		}
+	}
+
+	return node;
+}
+
+static void hs_port_guide_read_functions(
+	void)
+{
+	static char const *const volume_names[4] =
+		{ "volume_test_objects", "volume_test_object", "volume_test_objects_all", "volume_test_objects_any" };
+	static char const *const player_names[2] = { "players", "player" };
+	short index, name_index;
+
+	for (name_index = 0; name_index<4; name_index++)
+		hs_port_guide.volume_functions[name_index] = NONE;
+	for (name_index = 0; name_index<2; name_index++)
+		hs_port_guide.player_functions[name_index] = NONE;
+	for (index = 0; index<hs_function_table_count; index++)
+	{
+		struct hs_function_definition *definition = hs_function_get(index);
+
+		if (definition && definition->name)
+		{
+			for (name_index = 0; name_index<4; name_index++)
+				if (!strcmp(definition->name, volume_names[name_index]))
+					hs_port_guide.volume_functions[name_index] = index;
+			for (name_index = 0; name_index<2; name_index++)
+				if (!strcmp(definition->name, player_names[name_index]))
+					hs_port_guide.player_functions[name_index] = index;
+		}
+	}
+	hs_port_guide.functions_read = TRUE;
+
+	return;
+}
+
+static char const *hs_port_guide_script_name(
+	long script_index)
+{
+	struct scenario *scenario = global_scenario_get();
+
+	if (script_index>=0 && script_index<scenario->hs_scripts.count)
+		return TAG_BLOCK_GET_ELEMENT(&scenario->hs_scripts, script_index, struct hs_script)->name;
+
+	return "";
+}
+
+/* whether an expression names the players: (players), (player), or a script of
+the level's own such as player0 */
+static boolean hs_port_guide_names_players(
+	long expression_index,
+	short *budget)
+{
+	boolean result = FALSE;
+
+	while (!result && expression_index!=NONE && --*budget>0)
+	{
+		struct hs_syntax_node *node = hs_port_guide_node(expression_index);
+
+		if (!node)
+			break;
+		if (TEST_FLAG(node->flags, _hs_syntax_node_script_bit))
+		{
+			result = !strncmp(hs_port_guide_script_name(node->script_index), "player", 6);
+		}
+		else if (!TEST_FLAG(node->flags, _hs_syntax_node_primitive_bit))
+		{
+			if (node->function_index==hs_port_guide.player_functions[0] ||
+				node->function_index==hs_port_guide.player_functions[1])
+			{
+				result = TRUE;
+			}
+			else
+			{
+				struct hs_syntax_node *name = hs_port_guide_node(node->data);
+
+				if (name)
+					result = hs_port_guide_names_players(name->next_node_index, budget);
+			}
+		}
+		expression_index = node->next_node_index;
+	}
+
+	return result;
+}
+
+typedef void (*hs_port_guide_volume_proc)(short trigger_volume_index, void *data);
+
+/* every volume_test_objects ... (players) in an expression, its arguments and
+the static scripts it calls */
+static void hs_port_guide_find_volumes(
+	long expression_index,
+	boolean siblings,
+	short depth,
+	short *budget,
+	hs_port_guide_volume_proc proc,
+	void *data)
+{
+	while (expression_index!=NONE && --*budget>0)
+	{
+		struct hs_syntax_node *node = hs_port_guide_node(expression_index);
+
+		if (!node)
+			break;
+		if (TEST_FLAG(node->flags, _hs_syntax_node_script_bit))
+		{
+			struct scenario *scenario = global_scenario_get();
+
+			if (depth>0 && node->script_index>=0 && node->script_index<scenario->hs_scripts.count)
+			{
+				hs_port_guide_find_volumes(
+					TAG_BLOCK_GET_ELEMENT(&scenario->hs_scripts, node->script_index, struct hs_script)->root_expression_index,
+					FALSE, depth-1, budget, proc, data);
+			}
+		}
+		else if (!TEST_FLAG(node->flags, _hs_syntax_node_primitive_bit))
+		{
+			struct hs_syntax_node *name = hs_port_guide_node(node->data);
+			short function_index;
+			boolean volume_test = FALSE;
+
+			for (function_index = 0; function_index<4; function_index++)
+				if (hs_port_guide.volume_functions[function_index]!=NONE &&
+					node->function_index==hs_port_guide.volume_functions[function_index])
+				{
+					volume_test = TRUE;
+				}
+
+			if (name && volume_test)
+			{
+				struct hs_syntax_node *volume = hs_port_guide_node(name->next_node_index);
+				short player_budget = 64;
+
+				if (volume && TEST_FLAG(volume->flags, _hs_syntax_node_primitive_bit) &&
+					volume->type==_hs_type_trigger_volume &&
+					hs_port_guide_names_players(volume->next_node_index, &player_budget))
+				{
+					proc(volume->short_value, data);
+				}
+			}
+			else if (name)
+			{
+				hs_port_guide_find_volumes(name->next_node_index, TRUE, depth, budget, proc, data);
+			}
+		}
+
+		if (!siblings)
+			break;
+		expression_index = node->next_node_index;
+	}
+
+	return;
+}
+
+static void hs_port_guide_note_volume(
+	short trigger_volume_index,
+	void *data)
+{
+	short order = *(short *)data;
+
+	if (trigger_volume_index>=0 && trigger_volume_index<HS_PORT_GUIDE_MAXIMUM_VOLUMES &&
+		(hs_port_guide.volume_order[trigger_volume_index]==NONE ||
+			hs_port_guide.volume_order[trigger_volume_index]>order))
+	{
+		hs_port_guide.volume_order[trigger_volume_index] = order;
+	}
+
+	return;
+}
+
+/* the route of this level: the one most of whose scripts it has */
+static void hs_port_guide_match(
+	void)
+{
+	struct scenario *scenario = global_scenario_get();
+	char const *const *route = hs_port_guide_routes;
+	char const *const *best_route = NULL;
+	short best_found = 0;
+	short index;
+
+	hs_port_guide.scripts_address = scenario->hs_scripts.address;
+	hs_port_guide.scripts_count = scenario->hs_scripts.count;
+	hs_port_guide.matched = FALSE;
+	hs_port_guide.count = 0;
+	hs_port_guide.progress = 0;
+	for (index = 0; index<HS_PORT_GUIDE_MAXIMUM_VOLUMES; index++)
+		hs_port_guide.volume_order[index] = NONE;
+
+	while (*route)
+	{
+		char const *const *name;
+		short total = 0, found = 0;
+
+		for (name = route; *name; name++)
+		{
+			long script_index;
+
+			total++;
+			for (script_index = 0; script_index<scenario->hs_scripts.count; script_index++)
+			{
+				if (!strcmp(*name, hs_port_guide_script_name(script_index)))
+				{
+					found++;
+					break;
+				}
+			}
+		}
+		if (found>=3 && found*2>=total && found>best_found)
+		{
+			best_route = route;
+			best_found = found;
+		}
+		route = name+1;
+	}
+
+	if (best_route)
+	{
+		char const *const *name;
+
+		for (name = best_route; *name && hs_port_guide.count<HS_PORT_GUIDE_MAXIMUM_SCRIPTS; name++)
+		{
+			long script_index;
+
+			for (script_index = 0; script_index<scenario->hs_scripts.count; script_index++)
+			{
+				if (!strcmp(*name, hs_port_guide_script_name(script_index)))
+				{
+					short order = hs_port_guide.count;
+					short budget = HS_PORT_GUIDE_MAXIMUM_NODES;
+
+					hs_port_guide.script_indices[hs_port_guide.count++] = (short)script_index;
+					hs_port_guide_find_volumes(
+						TAG_BLOCK_GET_ELEMENT(&scenario->hs_scripts, script_index, struct hs_script)->root_expression_index,
+						FALSE, HS_PORT_GUIDE_MAXIMUM_DEPTH, &budget, hs_port_guide_note_volume, &order);
+					break;
+				}
+			}
+		}
+		hs_port_guide.matched = hs_port_guide.count>0;
+	}
+
+	return;
+}
+
+/* the point of a volume nearest the player: where the player walks into it (a
+volume can be big, its middle far over a wall or the sea) */
+static void hs_port_guide_volume_point(
+	short trigger_volume_index,
+	real_point3d const *player,
+	real_point3d *point)
+{
+	struct scenario_trigger_volume *volume = TAG_BLOCK_GET_ELEMENT(
+		&global_scenario_get()->trigger_volumes,
+		trigger_volume_index,
+		struct scenario_trigger_volume);
+
+	if (volume->type==_scenario_trigger_volume_type_axis_aligned)
+	{
+		point->x = PIN(player->x, volume->bounds.x0, volume->bounds.x1);
+		point->y = PIN(player->y, volume->bounds.y0, volume->bounds.y1);
+		point->z = PIN(player->z, volume->bounds.z0, volume->bounds.z1);
+	}
+	else
+	{
+		real_matrix4x3 matrix;
+		real_point3d local;
+
+		matrix4x3_from_point_and_vectors(&matrix, &volume->position, &volume->forward, &volume->up);
+		matrix4x3_inverse_transform_point(&matrix, player, &local);
+		local.x = PIN(local.x, 0.f, volume->extents.i);
+		local.y = PIN(local.y, 0.f, volume->extents.j);
+		local.z = PIN(local.z, 0.f, volume->extents.k);
+		matrix4x3_transform_point(&matrix, &local, point);
+	}
+
+	return;
+}
+
+struct hs_port_guide_choice
+{
+	real_point3d const *player;
+	real_point3d target;
+	real best_distance_squared;
+	boolean found;
+};
+
+static void hs_port_guide_consider_volume(
+	short trigger_volume_index,
+	void *data)
+{
+	struct hs_port_guide_choice *choice = data;
+
+	if (trigger_volume_index>=0 &&
+		trigger_volume_index<global_scenario_get()->trigger_volumes.count &&
+		!scenario_trigger_volume_test_point(trigger_volume_index, choice->player))
+	{
+		real_point3d point;
+		real distance_squared;
+
+		hs_port_guide_volume_point(trigger_volume_index, choice->player, &point);
+		distance_squared = distance_squared3d(choice->player, &point);
+		if (!choice->found || distance_squared<choice->best_distance_squared)
+		{
+			choice->target = point;
+			choice->best_distance_squared = distance_squared;
+			choice->found = TRUE;
+		}
+	}
+
+	return;
+}
+
+/* the volume a thread's sleep_until waits for, if it waits for the players to
+walk into one */
+static boolean hs_port_guide_thread_target(
+	struct hs_thread_datum *thread,
+	real_point3d const *player,
+	real_point3d *target)
+{
+	struct hs_port_guide_choice choice;
+	struct hs_stack_frame *frame = thread->stack;
+	short frames = 0;
+
+	choice.player = player;
+	choice.found = FALSE;
+	choice.best_distance_squared = 0.f;
+	while (!choice.found && frame && frames++<64 &&
+		(byte *)frame>=thread->stack_data && (byte *)frame<thread->stack_data+HS_THREAD_STACK_SIZE)
+	{
+		struct hs_syntax_node *node = hs_port_guide_node(frame->expression_index);
+
+		if (node && !TEST_FLAG(node->flags, _hs_syntax_node_primitive_bit) &&
+			!TEST_FLAG(node->flags, _hs_syntax_node_script_bit) &&
+			node->function_index==_hs_function_sleep_until)
+		{
+			struct hs_syntax_node *name = hs_port_guide_node(node->data);
+			short budget = HS_PORT_GUIDE_MAXIMUM_NODES;
+
+			if (name)
+				hs_port_guide_find_volumes(name->next_node_index, FALSE, HS_PORT_GUIDE_MAXIMUM_DEPTH,
+					&budget, hs_port_guide_consider_volume, &choice);
+			break;
+		}
+		frame = frame->previous;
+	}
+	if (choice.found)
+		*target = choice.target;
+
+	return choice.found;
+}
+
+boolean hs_port_guide_find_target(
+	real_point3d const *player,
+	real_point3d *target)
+{
+	struct scenario *scenario;
+	long threads[HS_PORT_GUIDE_MAXIMUM_SCRIPTS];
+	long thread_index;
+	short order, fallback = NONE;
+	real best_distance_squared = 0.f;
+	boolean found = FALSE;
+
+	if (!hs_runtime_globals.initialized || !hs_thread_data || global_scenario_index==NONE)
+		return FALSE;
+
+	scenario = global_scenario_get();
+	if (!hs_port_guide.functions_read)
+		hs_port_guide_read_functions();
+	if (hs_port_guide.scripts_address!=scenario->hs_scripts.address ||
+		hs_port_guide.scripts_count!=scenario->hs_scripts.count)
+	{
+		hs_port_guide_match();
+	}
+	if (!hs_port_guide.matched)
+		return FALSE;
+
+	/* a saved game loaded (the time goes back): the furthest place is found again */
+	if (game_time_get()<hs_port_guide.last_time)
+		hs_port_guide.progress = 0;
+	hs_port_guide.last_time = game_time_get();
+
+	/* the furthest place the player has been: the route's volumes it is in */
+	for (thread_index = 0;
+		thread_index<scenario->trigger_volumes.count && thread_index<HS_PORT_GUIDE_MAXIMUM_VOLUMES;
+		thread_index++)
+	{
+		short volume_order = hs_port_guide.volume_order[thread_index];
+
+		if (volume_order!=NONE && volume_order>hs_port_guide.progress &&
+			scenario_trigger_volume_test_point((short)thread_index, player))
+		{
+			hs_port_guide.progress = volume_order;
+		}
+	}
+
+	for (order = 0; order<hs_port_guide.count; order++)
+		threads[order] = NONE;
+	for (thread_index = data_next_index(hs_thread_data, NONE);
+		thread_index!=NONE;
+		thread_index = data_next_index(hs_thread_data, thread_index))
+	{
+		struct hs_thread_datum *thread = hs_thread_get(thread_index);
+
+		if (thread->type==_hs_thread_type_script)
+		{
+			for (order = 0; order<hs_port_guide.count; order++)
+				if (hs_port_guide.script_indices[order]==thread->script_index)
+					threads[order] = thread_index;
+		}
+	}
+
+	/* of the scripts waiting from the furthest place on, the nearest volume: a
+	level's main script waits for the next part of the level while the part's own
+	scripts wait for the steps on the way there (The Silent Cartographer's beach,
+	first its rocks, camp and arch); else the last before the furthest place */
+	for (order = 0; order<hs_port_guide.count; order++)
+	{
+		if (threads[order]!=NONE)
+		{
+			struct hs_thread_datum *thread = hs_thread_get(threads[order]);
+
+			if (thread->sleep_until>=0 && valid_thread(thread))
+			{
+				if (order>=hs_port_guide.progress)
+				{
+					real_point3d candidate;
+
+					if (hs_port_guide_thread_target(thread, player, &candidate))
+					{
+						real distance_squared = distance_squared3d(player, &candidate);
+
+						if (!found || distance_squared<best_distance_squared)
+						{
+							*target = candidate;
+							best_distance_squared = distance_squared;
+							found = TRUE;
+						}
+					}
+				}
+				else if (!found)
+				{
+					real_point3d candidate;
+
+					if (hs_port_guide_thread_target(thread, player, &candidate))
+					{
+						fallback = order;
+						if (fallback!=NONE)
+							*target = candidate;
+					}
+				}
+			}
+		}
+	}
+
+	return found || fallback!=NONE;
+}

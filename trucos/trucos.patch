+/* port: a cheat that the player has on in the settings. Each is on for
+every tick of a game that is the player's own (not on a network: there the
+host's rules hold, cheats_network_client_enforce), put back each tick so
+that a map's scripts (b30's, around its cinematics) do not leave it off.
+Turning one off in the settings clears it once; while its setting is off,
+the console's and the maps' own use of the cheat is left alone */
+struct cheat_setting
+{
+	char const *name;
+	boolean *state;
+	boolean wanted;
+	boolean clear;
+};
+
+static struct cheat_setting cheat_settings[] =
+{
+	{ "cheats.infinite_ammo", &cheat.infinite_ammo, FALSE, FALSE },
+	{ "cheats.bottomless_clip", &cheat.bottomless_clip, FALSE, FALSE },
+	{ "cheats.super_jump", &cheat.super_jump, FALSE, FALSE },
+	{ "cheats.deathless_player", &cheat.deathless_player, FALSE, FALSE },
+	{ "cheats.omnipotent", &cheat.omnipotent, FALSE, FALSE },
+	{ "cheats.medusa", &cheat.medusa, FALSE, FALSE },
+	{ "cheats.jetpack", &cheat.jetpack, FALSE, FALSE },
+	{ "cheats.bump_possession", &cheat.bump_possession, FALSE, FALSE },
+	{ "cheats.reflexive_damage_effects", &cheat.reflexive_damage_effects, FALSE, FALSE },
+};
